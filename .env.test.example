# Local secrets for the e2e suite. Copy to .env.test (gitignored) and fill in.
#
# Optional live Discord check (npm run test:e2e:live): the URL of a webhook in a throwaway channel
# you own. It is a credential: never commit it, and never paste it into an issue or a log. The
# live spec posts one embed and one attachment to it. Leave it empty to skip the live check.
DISCORD_TEST_WEBHOOK_URL=
